* text=auto eol=lf

# Texts
# Windows batch scripts: keep CRLF + CP932 (Shift_JIS) in the working tree for
# native tools like cmd.exe, while the blob is stored as UTF-8 in the repo.
*.bat text eol=crlf working-tree-encoding=CP932
*.cmd text eol=crlf working-tree-encoding=CP932

*.c text
*.h text
*.cpp text

*.txt text
*.md text
*.sh text eol=lf
*.ps1 text eol=crlf

*.sln text eol=crlf
*.def text eol=crlf
*.vcxproj text eol=crlf

# Preserve formatting inherited from the original source and legal notice.
source/RhythmDriver.* whitespace=-trailing-space
source/SynthDriver.* whitespace=-trailing-space
source/emu2413/** whitespace=-trailing-space
